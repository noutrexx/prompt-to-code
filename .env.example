# Google Gemini API anahtari
# https://aistudio.google.com/app/apikey adresinden alabilirsiniz.
GEMINI_API_KEY=buraya_api_anahtarinizi_yazin

# Virgulle ayrilmis izin verilen frontend originleri.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Pahali strateji endpoint'i korumalari.
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_STRATEGIES=2
MAX_REQUEST_BODY_BYTES=4096
